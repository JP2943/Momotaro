{
  "version": 1,
  "phase": "P6C",
  "note": "P6C（ジャスト回避と防御反撃）の必須テスト一覧。P6C 仕様 v1.0 §10 の ID を実際の完全修飾テスト名へ対応させる。テストランナーの外で確認する要求（P6C15：Builder 再生成 build-phase6c-world、検査 validate-phase6c-world、既存必須一覧 P4／P5／P5.5／P6A／P6B の再照合、Windows 実ビルドの実入力と別プロセス Continue＝ブリッジ op p6c-player-smoke）は requirements に載せず、P6C_受入条件対応表.md と P6C_統合受入結果.md に証跡を記録する。",
  "stages": [
    "P6C-01",
    "P6C-02",
    "P6C-03",
    "P6C-04"
  ],
  "requirements": [
    {
      "id": "P6C01",
      "summary": "実接触・敵攻撃・ステップ無敵と受付の重なりでのみ成功。離れて回避、窓外、被弾後無敵だけでは報酬なし",
      "stage": "P6C-01"
    },
    {
      "id": "P6C02",
      "summary": "無敵開始・受付終端・無敵終端の境界、異なるdeltaTime、Pause・ヒットストップで一貫した判定",
      "stage": "P6C-01"
    },
    {
      "id": "P6C03",
      "summary": "1ステップ1回、同HitId・複数Collider・複数フレーム・再入通知で重複成功しない",
      "stage": "P6C-01"
    },
    {
      "id": "P6C04",
      "summary": "多段・複数敵・飛び道具で無敵の範囲だけ回避。成功による後続攻撃の無料無効化や旧反射・強制ひるみなし",
      "stage": "P6C-01"
    },
    {
      "id": "P6C05",
      "summary": "強化1.5倍・2秒、別成功で時間更新、蓄積なし、通常攻撃以外に倍率が混入しない",
      "stage": "P6C-02"
    },
    {
      "id": "P6C06",
      "summary": "開始受理時に消費。拒否入力では残る。空振り・被弾取消で返還なし、満了前開始なら満了後命中も強化",
      "stage": "P6C-02"
    },
    {
      "id": "P6C07",
      "summary": "一段の複数対象は強化、次段と再利用Hitboxは通常。既存重複命中防止を維持",
      "stage": "P6C-02"
    },
    {
      "id": "P6C08",
      "summary": "成長倍率との積、防御・スタン・丸めを含む計算例。体幹・ひるみ・仲間・必殺への非適用",
      "stage": "P6C-02"
    },
    {
      "id": "P6C09",
      "summary": "通常ガード不可の実敵攻撃で通常ガード失敗・ジャスガ成功。正面・受付・ブレイク等の既存条件維持",
      "stage": "P6C-03"
    },
    {
      "id": "P6C10",
      "summary": "防御可否を近接・Projectile・Builder・Validatorまで保持。例外fixtureの不可条件と予告整合",
      "stage": "P6C-03"
    },
    {
      "id": "P6C11",
      "summary": "かばう・被弾後無敵・同フレーム死亡との優先関係、二重反応と死亡後強化なし",
      "stage": "P6C-01"
    },
    {
      "id": "P6C12",
      "summary": "Save非破壊、Continueで強化なし、報酬保持。休息等と通常遷移成功で消去、移動失敗では保持",
      "stage": "P6C-02"
    },
    {
      "id": "P6C13",
      "summary": "きびだんご中の回避・ガード禁止と被弾中断。成長効果の累積・消失なし",
      "stage": "P6C-02"
    },
    {
      "id": "P6C14",
      "summary": "実成功の音・表示、強化消費・期限、二Areaの配信元、遷移後表示、既存VFX維持",
      "stage": "P6C-04"
    }
  ],
