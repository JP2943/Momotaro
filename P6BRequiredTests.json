{
  "version": 1,
  "phase": "P6B",
  "note": "P6B（成長ときびだんご）の必須テスト一覧。P6B 仕様 v1.0 §11 の ID を実際の完全修飾テスト名へ対応させる。テストランナーの外で確認する要求（P6B19 実ビルドの別プロセス復元＝ブリッジ op p6b-player-smoke、既存必須一覧 P4／P5／P5.5／P6A の再照合）は requirements に載せず、P6B_受入条件対応表.md に証跡を記録する。Builder／Validator の検査（build-phase6b-world／validate-phase6b-world）は P6B17 の補助で、テストではない。",
  "stages": [
    "P6B-01",
    "P6B-02",
    "P6B-03",
    "P6B-04"
  ],
  "requirements": [
    {
      "id": "P6B01",
      "summary": "9ノードの前提と費用、三方向混合、未知ID・取得済み・徳不足・前提不足・場所外の無変更",
      "stage": "P6B-01"
    },
    {
      "id": "P6B02",
      "summary": "各効果が設定値どおり。全取得の合計、刀と仲間・通常体幹とジャスガ等への適用範囲",
      "stage": "P6B-01"
    },
    {
      "id": "P6B03",
      "summary": "取得後に新上限で休息・補充・普通敵周期更新・保存が各一回",
      "stage": "P6B-01"
    },
    {
      "id": "P6B04",
      "summary": "基礎値からの再計算、取得と取消の反復、遷移・非活動Area再入場・死亡・Loadで非累積",
      "stage": "P6B-01"
    },
    {
      "id": "P6B05",
      "summary": "末端のみ取消可能。複数子を持つテスト用前提グラフでも親を誤って取り消せない",
      "stage": "P6B-02"
    },
    {
      "id": "P6B06",
      "summary": "実支出返還、累計不変、使用済み減少、権利一回減少、価格変更後の返還と再取得",
      "stage": "P6B-02"
    },
    {
      "id": "P6B07",
      "summary": "払い戻し後の上限低下と休息、残数上限、普通敵一周期。不成立・取消・連打時の無変更または一回処理",
      "stage": "P6B-02"
    },
    {
      "id": "P6B08",
      "summary": "初期3・上限6・章ごと＋3。上限で追加0の章も処理済み。Load・再通知で重複追加なし",
      "stage": "P6B-02"
    },
    {
      "id": "P6B09",
      "summary": "使用可能条件と禁止状態、HP満タン・残数0、同時入力、長押しで連続使用なし",
      "stage": "P6B-03"
    },
    {
      "id": "P6B10",
      "summary": "2秒動作、1.5秒で回復と1個消費を同時に一回確定。0.5秒後隙、20％移動、禁止行動・無敵付与なし",
      "stage": "P6B-03"
    },
    {
      "id": "P6B11",
      "summary": "確定前後の実被弾、中断、死亡、無敵中の無効接触、かばうとの整合。同フレーム競合の規則",
      "stage": "P6B-03"
    },
    {
      "id": "P6B12",
      "summary": "Pause・ヒットストップ・長いフレームで時間と一回確定が正しい。開始後HP満タンの扱い",
      "stage": "P6B-03"
    },
    {
      "id": "P6B13",
      "summary": "使用中の通常遷移禁止と場外防止、終了後に離れ直さず外向き入力で遷移可能",
      "stage": "P6B-03"
    },
    {
      "id": "P6B14",
      "summary": "使用確定の保存要求、HPと残数の整合、使用中Snapshot非破壊、確定前後の正常終了とContinue",
      "stage": "P6B-03"
    },
    {
      "id": "P6B15",
      "summary": "保存失敗から復帰しても使用を巻き戻さず、権利・徳・取得の成立を維持。追加要求を取りこぼさない",
      "stage": "P6B-03"
    },
    {
      "id": "P6B16",
      "summary": "新規保存項目を非初期値でRoundTrip、旧版移行、欠損・未知ID・前提矛盾拒否、P6A保存維持",
      "stage": "P6B-02"
    },
    {
      "id": "P6B17",
      "summary": "Builder再生成、StableId・前提循環・未知参照・値検査。生成後もUIと入力とVFXが接続",
      "stage": "P6B-04"
    },
    {
      "id": "P6B18",
      "summary": "UIの効果・費用・返還表示、ゲームパッド操作、キャンセル、解放待ちとGameplayへの入力漏れなし",
      "stage": "P6B-04"
    }
  ],
